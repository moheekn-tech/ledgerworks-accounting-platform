# Local SQLite and explicit fixture connectors run without credentials.
PORT=4310
HOST=127.0.0.1
DATA_DIR=./data
# Set to use PostgreSQL instead of SQLite. The schema is created automatically.
# DATABASE_URL=postgres://accounting:change-me@localhost:5432/accounting
ORCHESTRATOR=local
# ORCHESTRATOR=temporal
# TEMPORAL_ADDRESS=localhost:7233
# Optional bounded model coding. No model is silently chosen.
# OPENAI_API_KEY=
# OPENAI_MODEL=
AGENT_RUNTIME=pi
# AGENT_RUNTIME=responses selects the direct structured-output classifier instead.
# Provision users with scripts/provision-user.ps1, then configure this file.
# AUTH_USERS_FILE=./data/auth-users.json
# COOKIE_SECURE=true requires HTTPS. Production enables secure cookies automatically.
# Live writes are disabled by default even with configured connections.
ALLOW_LIVE_WRITES=false
# Fixture company IDs: native-demo, tally-demo, zoho-demo.
# Live company profiles are configured through the settings API / UI.
